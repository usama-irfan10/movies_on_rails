<% content_for :title, "Choose a new password" %>
<h1 class="page-title">Choose a new password</h1>

<%= form_with url: password_path(params[:token]), method: :put, class: "auth-form" do |form| %>
  <div class="field">
    <%= form.label :password, "New password (at least #{User::MIN_PASSWORD_LENGTH} characters)" %>
    <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password",
                            minlength: User::MIN_PASSWORD_LENGTH, maxlength: 72 %>
  </div>
  <div class="field">
    <%= form.label :password_confirmation, "Repeat new password" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
                            minlength: User::MIN_PASSWORD_LENGTH, maxlength: 72 %>
  </div>
  <%= form.submit "Save password" %>
<% end %>
