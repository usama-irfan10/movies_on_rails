<% if pagination.total_pages > 1 %>
  <nav class="pagination" aria-label="Pagination">
    <% if pagination.prev_page? %>
      <%= link_to "Previous", movies_path(actor: query.presence, sort:, per_page: pagination.per_page_param, page: pagination.page - 1), rel: "prev" %>
    <% end %>
    <span>Page <%= pagination.page %> of <%= pagination.total_pages %></span>
    <% if pagination.next_page? %>
      <%= link_to "Next", movies_path(actor: query.presence, sort:, per_page: pagination.per_page_param, page: pagination.page + 1), rel: "next" %>
    <% end %>
  </nav>
<% end %>
