<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Movies on Rails" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <%= link_to "Movies on Rails", root_path, class: "site-title" %>
        <% if authenticated? %>
          <%= button_to "Sign out", session_path, method: :delete, class: "link-button" %>
        <% end %>
      </div>
    </header>
    <main>
      <% if notice %><p class="flash notice" role="status"><%= notice %></p><% end %>
      <% if alert %><p class="flash alert" role="alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
