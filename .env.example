# Copy to .env for local use:  cp .env.example .env
# .env is git-ignored and read by dotenv-rails (development/test) and by `docker compose`.
# Every variable is optional in development. Real environment variables always win over .env.

# --- Docker Compose only -------------------------------------------------
# Host port the app is published on (default 3000)
# APP_PORT=3000
# Password for the local PostgreSQL container (default "postgres")
# POSTGRES_PASSWORD=postgres

# --- Rails (development and production) ----------------------------------
# Host (and port) used in links inside emails. REQUIRED in production, e.g. movies.example.com
# APP_HOST=localhost:3000
# Sender address of outgoing emails
# MAILER_FROM=no-reply@example.com
# Full database connection string (overrides config/database.yml), e.g.
# DATABASE_URL=postgres://user:password@localhost:5432
# Puma threads and port when running without Docker
# RAILS_MAX_THREADS=3
# PORT=3000
# Log verbosity: debug, info, warn, error (production default: info)
# RAILS_LOG_LEVEL=info

# --- Production secrets (set in your host, never commit them) --------------
# RAILS_MASTER_KEY=...       # or SECRET_KEY_BASE=...
